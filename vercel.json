{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebot|facebook|twitterbot|twitter|telegrambot|telegram|linkedinbot|linkedin|discordbot|discord|slackbot|slack|applebot|opengraph|crawler|spider|bot|preview|postman|curl|wget).*"
        }
      ],
      "destination": "/api/meta?path=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
